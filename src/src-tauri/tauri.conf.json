{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScanDetection",
  "version": "0.1.0",
  "identifier": "com.scandetection.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "title": "ScanDetection", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": []
  }
}
