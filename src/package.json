{
  "name": "scan-detection-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pkg": "vue-tsc --noEmit && vite build --config vite.tauri.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,vue}\""
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "2.4.9",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "jsdom": "^29.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0"
  }
}
