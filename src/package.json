{
  "name": "scan-detection-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pkg": "vue-tsc --noEmit && vite build --config vite.tauri.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "gen-api": "openapi-typescript http://127.0.0.1:18773/openapi.json -o src/types/generated.ts"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "typescript-eslint": "^7.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.2.0"
  }
}
